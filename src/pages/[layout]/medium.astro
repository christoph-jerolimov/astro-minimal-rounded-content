---
import Layout from '../../layouts/Layout.astro';
import { layoutPaths } from '../../layouts';

export const getStaticPaths = layoutPaths;

const { layout } = Astro.params;

const sections = [
  {
    title: 'Layout',
    body: 'The page uses a header row on top and a two-column CSS grid below it: a fixed-width sidebar on the left and a flexible content area on the right.',
  },
  {
    title: 'Rounded content',
    body: 'The content area carries a 2px border and a large border-radius. How it handles overflow depends on the layout option chosen in the header.',
  },
  {
    title: 'Four options',
    body: 'Option 1 scrolls the box itself, option 2 scrolls an inner wrapper, option 3 caps the box at the viewport height, and option 4 fixes the box to the viewport.',
  },
  {
    title: 'Responsive',
    body: 'Below 640px the grid collapses to a single column and the sidebar sits above the content.',
  },
];
---

<Layout title="Medium page" layout={layout}>
  <h1>Medium page</h1>
  <p>
    This page has a moderate amount of content. Depending on the viewport
    height it may or may not need to scroll.
  </p>

  {sections.map((section) => (
    <section>
      <h2>{section.title}</h2>
      <p>{section.body}</p>
    </section>
  ))}
</Layout>
