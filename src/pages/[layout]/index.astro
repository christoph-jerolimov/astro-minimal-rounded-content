---
import Layout from '../../layouts/Layout.astro';
import { layoutPaths } from '../../layouts';

export const getStaticPaths = layoutPaths;

const { layout } = Astro.params;
---

<Layout title="Short page" layout={layout}>
  <h1>Short page</h1>
  <p>
    This page has very little content. Use the navigation on the left to switch
    to pages with more content, and the header to compare how each of the four
    layout options keeps the rounded box static while the content scrolls.
  </p>
</Layout>
