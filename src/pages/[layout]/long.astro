---
import Layout from '../../layouts/Layout.astro';
import { layoutPaths } from '../../layouts';

export const getStaticPaths = layoutPaths;

const { layout } = Astro.params;

const paragraphs = Array.from({ length: 24 }, (_, i) => i + 1);
---

<Layout title="Long page" layout={layout}>
  <h1>Long page</h1>
  <p>
    This page has a lot of content, far more than fits in the viewport. Scroll
    inside the rounded box to see that the border and radius stay static while
    the content moves.
  </p>

  {paragraphs.map((n) => (
    <section>
      <h2>Section {n}</h2>
      <p>
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod
        tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim
        veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea
        commodo consequat. Duis aute irure dolor in reprehenderit in voluptate
        velit esse cillum dolore eu fugiat nulla pariatur.
      </p>
    </section>
  ))}
</Layout>
