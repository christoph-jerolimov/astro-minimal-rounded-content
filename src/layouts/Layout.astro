---
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import { getLayout } from '../layouts';

interface Props {
  title: string;
  layout: string;
}

const { title, layout } = Astro.props;
const option = getLayout(layout);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · {option.label}</title>
  </head>
  <body>
    <div class="page" data-layout={layout}>
      <Header layout={layout} />
      <div class="shell">
        <aside class="shell__sidebar">
          <Sidebar layout={layout} />
        </aside>
        <main class="shell__content">
          {
            layout === 'inner-scroll' ? (
              <div class="shell__scroll">
                <slot />
              </div>
            ) : (
              <slot />
            )
          }
        </main>
      </div>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f3f4f6;
    --fg: #111827;
    --panel: #ffffff;
    --border: #d1d5db;
    --nav-hover: #e5e7eb;
    --nav-active: #dbeafe;
    --radius: 2rem;
    --gap: 1.5rem;
    --sidebar-w: 220px;
    --header-h: 3.5rem;
    --content-pad: 2rem 2.5rem;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #111827;
      --fg: #f9fafb;
      --panel: #1f2937;
      --border: #4b5563;
      --nav-hover: #374151;
      --nav-active: #1e3a8a;
    }
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    height: 100%;
  }

  body {
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    line-height: 1.6;
    color: var(--fg);
    background: var(--bg);
  }

  h1 {
    margin-top: 0;
  }
</style>

<style>
  /* ---------- Shared frame: header on top, sidebar + content below ---------- */

  .page {
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100dvh;
  }

  .shell {
    display: grid;
    grid-template-columns: var(--sidebar-w) 1fr;
    gap: var(--gap);
    padding: var(--gap);
    min-height: 0; /* allow the row to shrink so children can scroll */
  }

  .shell__sidebar {
    align-self: start;
  }

  .shell__content {
    background: var(--panel);
    border: 2px solid var(--border);
    border-radius: var(--radius);
    padding: var(--content-pad);
  }

  /* ---------- Option 1: the box is the scroll container ---------- */

  [data-layout='box-scroll'] .shell__content {
    align-self: stretch;
    min-height: 0;
    overflow-y: auto;
  }

  /* ---------- Option 2: static frame, inner wrapper scrolls ---------- */

  [data-layout='inner-scroll'] .shell__content {
    align-self: stretch;
    min-height: 0;
    overflow: hidden;
    padding: 0;
  }

  [data-layout='inner-scroll'] .shell__scroll {
    height: 100%;
    overflow-y: auto;
    padding: var(--content-pad);
  }

  /* ---------- Option 3: grows with content, capped at the viewport ---------- */

  [data-layout='max-height'] .shell__content {
    align-self: start;
    max-height: 100%;
    overflow-y: auto;
  }

  /* ---------- Option 4: fixed position, outside the grid ---------- */

  [data-layout='fixed'] .shell__content {
    position: fixed;
    top: calc(var(--header-h) + var(--gap));
    right: var(--gap);
    bottom: var(--gap);
    left: calc(var(--sidebar-w) + 2 * var(--gap));
    overflow-y: auto;
  }

  /* ---------- Narrow screens: sidebar above the content ---------- */

  @media (max-width: 640px) {
    :root {
      --gap: 1rem;
      --content-pad: 1.5rem;
    }

    .shell {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr;
    }

    [data-layout='fixed'] .shell__content {
      /* the sidebar height is unknown, so the fixed box just drops below the header */
      top: calc(var(--header-h) + var(--gap));
      left: var(--gap);
    }
  }
</style>
