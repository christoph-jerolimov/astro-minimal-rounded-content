---
import Sidebar from '../components/Sidebar.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <div class="shell">
      <aside class="shell__sidebar">
        <Sidebar />
      </aside>
      <main class="shell__content">
        <slot />
      </main>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f3f4f6;
    --fg: #111827;
    --panel: #ffffff;
    --border: #d1d5db;
    --nav-hover: #e5e7eb;
    --nav-active: #dbeafe;
    --radius: 2rem;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #111827;
      --fg: #f9fafb;
      --panel: #1f2937;
      --border: #4b5563;
      --nav-hover: #1f2937;
      --nav-active: #1e3a8a;
    }
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    min-height: 100%;
  }

  body {
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    line-height: 1.6;
    color: var(--fg);
    background: var(--bg);
  }

  h1 {
    margin-top: 0;
  }
</style>

<style>
  .shell {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 1.5rem;
    min-height: 100vh;
    padding: 1.5rem;
  }

  .shell__sidebar {
    position: sticky;
    top: 1.5rem;
    align-self: start;
  }

  .shell__content {
    /* The content box grows with its content; the border and large
       radius wrap whatever height the page happens to have. */
    align-self: start;
    padding: 2rem 2.5rem;
    background: var(--panel);
    border: 2px solid var(--border);
    border-radius: var(--radius);
  }

  @media (max-width: 640px) {
    .shell {
      grid-template-columns: 1fr;
      padding: 1rem;
    }

    .shell__sidebar {
      position: static;
    }

    .shell__content {
      padding: 1.5rem;
    }
  }
</style>
